# Local PostgreSQL (Drizzle + Better Auth adapter)
# Create the database first, e.g.: createdb hired_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hired-dev

# Better Auth — https://www.better-auth.com/docs/installation
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Client-side auth requests (browser); usually same origin as BETTER_AUTH_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
