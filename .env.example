# Local PostgreSQL (Drizzle + Better Auth adapter)
# Create the database first, e.g.: createdb hired_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hired-dev

# Better Auth — https://www.better-auth.com/docs/installation
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# Client-side auth requests (browser); usually same origin as BETTER_AUTH_URL
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Optional — Agentation MCP sync in dev: https://www.agentation.com/install
# Run: pnpx agentation-mcp server  (default port 4747)
NEXT_PUBLIC_AGENTATION_ENDPOINT=http://localhost:4747

# Maps JavaScript API + Places (browser autocomplete on job location, etc.)
# https://developers.google.com/maps/documentation/javascript/get-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Gemini (CV extraction) — AI SDK @ai-sdk/google
# https://ai-sdk.dev/providers/ai-sdk-providers/google-generative-ai
GOOGLE_GENERATIVE_AI_API_KEY=
# e.g. gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Local PDF storage (server). Files stored under this directory.
CV_UPLOAD_DIR=.data/cv-uploads
